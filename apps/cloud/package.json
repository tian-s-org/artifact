{
  "name": "@tian-s-org/cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "云端版：Cloudflare Worker + R2 + 独立沙箱源，画布与本地版共用同一份前端",
  "scripts": {
    "build:web": "pnpm --filter @tian-s-org/canvas exec vite build --outDir ../cloud/web --emptyOutDir",
    "build": "pnpm typecheck && pnpm build:web",
    "dev": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "push": "node --import tsx scripts/push.ts"
  },
  "dependencies": {
    "@tian-s-org/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "wrangler": "^4.0.0"
  }
}
