{
  "name": "@tian-s-org/canvas",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "画布底座：无限画布 SPA + 本地服务（文件协议、监听、版本、SSE），装进任意项目就能看画板",
  "bin": {
    "artifact-canvas": "./bin/artifact-canvas.mjs"
  },
  "exports": {
    "./server": "./server/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "src",
    "index.html",
    "vite.config.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tian-s-org/artifact.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "pnpm typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx tests/unit/*.test.ts",
    "test:e2e": "node --test --import tsx --test-concurrency=1 tests/e2e/*.test.ts",
    "probe:zoom": "node --import tsx scripts/zoom-probe.ts",
    "new-board": "node --import tsx scripts/new-board.ts",
    "versions": "node --import tsx scripts/version.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tian-s-org/canvas-core": "workspace:*",
    "@tian-s-org/schema": "workspace:*",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
