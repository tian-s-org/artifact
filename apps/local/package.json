{
  "name": "@artifact/local",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "本地优先版：无限画布 + 本地文件协议 + 文件监听实时刷新",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "pnpm typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx tests/unit/*.test.ts",
    "test:e2e": "node --test --import tsx --test-concurrency=1 tests/e2e/*.test.ts",
    "probe:zoom": "node --import tsx scripts/zoom-probe.ts",
    "new-board": "node --import tsx scripts/new-board.ts",
    "versions": "node --import tsx scripts/version.ts"
  },
  "dependencies": {
    "@artifact/canvas-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
