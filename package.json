{
  "name": "artifact",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm --filter @tian-s-org/canvas dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @tian-s-org/canvas start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tian-s-org/canvas test:e2e",
    "cloud:dev": "pnpm --filter @tian-s-org/cloud dev",
    "cloud:deploy": "pnpm --filter @tian-s-org/cloud deploy",
    "cloud:push": "pnpm --filter @tian-s-org/cloud push --",
    "artifact": "pnpm --filter @tian-s-org/cli dev --",
    "new-board": "pnpm --filter @tian-s-org/canvas new-board",
    "versions": "pnpm --filter @tian-s-org/canvas versions",
    "probe:zoom": "pnpm --filter @tian-s-org/canvas probe:zoom"
  }
}
