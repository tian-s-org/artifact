{
  "name": "@tian-s-org/canvas",
  "version": "0.3.0",
  "type": "module",
  "private": false,
  "description": "画布：Agent 写静态 HTML 画板，artifact push 到云端，浏览器只读查看",
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "bin": {
    "artifact": "./cli/artifact.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "cli",
    "dist",
    "skills",
    "src",
    "index.html",
    "vite.config.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tian-s-org/artifact.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx tests/unit/*.test.ts tests/cli/*.test.ts tests/worker/*.test.ts",
    "push": "node --import tsx worker/scripts/push.ts",
    "deploy": "vite build && wrangler deploy",
    "dev:worker": "wrangler dev --var DEV:1"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.0.0"
  }
}
